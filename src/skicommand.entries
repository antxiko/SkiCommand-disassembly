# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera da INIT en 0x8010.
0x8010   # INIT

# La interrupcion: 0x8456 escribe 0x8599 en 0xFDA0, la direccion del gancho H.TIMI
# (0xFD9F, que la BIOS llama en cada interrupcion del VDP).
0x8599   # la interrupcion del juego

# Ejecutadas en openMSX (comun/casio/omsx_cobertura.tcl: jugando y en la demo) y no alcanzadas por el
# trazado: el primer PC de cada tramo. Casi todas cuelgan de la interrupcion (H.TIMI) o de tablas de saltos.
