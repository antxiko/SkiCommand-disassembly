# UTILIDADES
# ======================================================================
L 0x9635 sprites_girados           Copia BC bytes de sprites (HL) a la VRAM (DE) y otra vez girados de lado, detras
L 0x9656 sprites_girados_uno       Un sprite: sus cuatro cuartos girados (0x96DA)
C 0x9675 todos, de 0xE000 a la VRAM
L 0x967D sprites_espejo            Copia BC bytes a 0xE400 y los deja en 0xE000 dados la vuelta (0x96A4)
L 0x96A4 espejo_mitad              Tres veces: los cuartos de 8x8 en su sitio, girados (0x96C7)
L 0x96A6 espejo_cuarto             Los cuatro cuartos de un sprite
L 0x96C7 espejo_casilla            Una casilla de 8x8 girada: las columnas pasan a filas
L 0x96C9 espejo_fila               Una fila de la casilla nueva
L 0x96CD espejo_bit                Un bit de cada fila vieja
L 0x96DA gira                      Gira C casillas de 8x8 (DE a HL): cada byte nuevo es una columna de la vieja
L 0x96DB gira_fila                 Una fila
L 0x96DE gira_bit                  Un bit
L 0x96EA lee4                      E, D, C, B de (HL), HL cuatro mas alla
L 0x96F3 guarda4_88d               E, D, C, B en la entrada 0xE88D
L 0x96F6 guarda4                   E, D, C, B en (HL)
L 0x96FF casilla_fila              La casilla de HL (RDVRM) menos 2 (0 = pista); por debajo de la fila 24 o en una bandera, 0
L 0x9715 casilla_cero              Nada
L 0x9717 casilla_xy                La casilla (RDVRM) debajo de la Y, X de HL
L 0x971D xy_nombres                De Y, X en pantalla (H, L) a su direccion en la tabla de nombres (0x1800 + Y/8*32 + X/8)
L 0x9739 pinta_ronda               La ronda (o un 1 en la demo), tres cifras, en DE
L 0x9743 pinta_ronda_demo          La demo: ronda 1
L 0x9745 pinta_ronda_cifras        Las cifras
L 0x9754 pinta_puntos              HL x 100 en seis cifras, en DE
L 0x9760 cifras                    HL en cinco cifras ASCII en 0xE894, y tres ceros detras
L 0x976A cifras_10000              Las decenas de millar
L 0x9779 cifras_1000               Los millares
L 0x9788 cifras_100                Las centenas
L 0x9797 cifras_10                 Las decenas
L 0x97B2 tramo                     Cada 256 cuadros: los dibujos de la nieve del tramo
C 0x97B2 en cuanto se pasa de 256 cuadros
L 0x97B7 tramo_dibujos             La nieve de cada tramo (0xE882): del 0 al 3, del 4 al 7, del 8 al 11 y del 12 en adelante
C 0x97BA del 0 al 3: 0xAF35...
C 0x97CB del 4 al 7: 0xB02D...
C 0x97D9 del 8 al 11: 0xB06B...
C 0x97E5 del 12 en adelante: 0xB0C8
L 0x97ED tramo_pinta               Los nombres de las ocho filas de arriba en 0xE000, los dibujos y los colores de la nieve
C 0x97EF la pista, sin curva (0xAF35)...
C 0x97FA ...y encima, la del tramo
C 0x981C y la pista entera a la tabla de nombres
L 0x981F irq_solo_musica_pon       La interrupcion de siempre (0x85A8): solo la musica
C 0x9825 el "jp" del gancho H.TIMI
L 0x982A musica_suena              NZ si el primer canal aun suena
L 0x982F nombres_borra             La tabla de nombres a cero, y los sprites fuera
L 0x9839 sprites_fuera             Los 32 sprites fuera de la pantalla (Y 0xC0), en la RAM y en la VRAM
L 0x9851 sprites_carga             Los dibujos de los sprites: los del esquiador (0xA1CD) y girados, y el resto (0xA34D)
C 0x986F las casillas 4 a 11, vacias
L 0x9879 ram_borra                 La RAM de la partida (0xE000-0xE903) a cero, las diez cuentas a 0xFF y lo que cae, fuera
C 0x9885 tampoco ronda acabada ni choque
L 0x989B demo                      NZ en la demo
L 0x98A0 aparato_sprites_fuera        Los sprites del aparato (0xE814), fuera
L 0x98B4 boton_disparo             Vuelve al de arriba si no esta el boton 1
L 0x98BC boton_suelto              El boton suelto
L 0x98C0 boton_nuevo               Vuelve al de arriba si el boton ya estaba pulsado
L 0x98C8 boton_marca               Lo marca pulsado
L 0x98CB ronda1_juega              Z en la ronda 1 jugando (no en la demo ni despues de ella)
L 0x98D5 tercio_copia              Copia los dibujos y los colores del primer tercio a los otros dos (LDIRMV y LDIRVM)
L 0x990C ldirvm                    LDIRVM y DE, HL avanzan BC
L 0x991A marcador_pinta            El marcador entero: HIGH SCORE, 1UP, ROUND, los puntos y las vidas
C 0x991A HIGH (0x9997)...
C 0x9926 ...SCORE...
C 0x992F ...1UP...
C 0x9938 ...ROUND
C 0x9941 el record
C 0x994A los puntos
C 0x9953 las vidas de reserva...
L 0x9963 marcador_vidas1           Hasta cinco en la fila 13...
L 0x9976 marcador_vidas2           ...y otras cinco en la 16
L 0x997C marcador_ronda            Y la ronda
L 0x9982 vidas                     A esquiadores (casillas 0x3E y 0x3F, una encima de otra)
D 0x9997 0x99A8 marcador_textos  HIGH, SCORE, 1UP y ROUND para el marcador
L 0x99A8 absoluto                  El valor absoluto de A
L 0x99AE azar                      Un numero al azar: el de antes rotado mas el registro R
L 0x99BD azar20                    Al azar de 0 a 19

# ======================================================================
# EL MOTOR DE SONIDO: tres canales (0xF002, 0xF022, 0xF042, 0x20 bytes)
# ======================================================================
# Cada canal: +0/+1 el principio de su pieza, +2 suena, +3/+4 por donde va,
# +5 la duracion de la nota, +6 lo que le queda de sonar, +7 lo que le queda
# hasta la siguiente, +8 el volumen, +9/+0A su envolvente, +0B el paso de la
# envolvente, +0C el tipo de envolvente, +0D el tempo, +0E su cuenta, +0F/+10
# la vuelta de una repeticion, +11 cuantas faltan, +12 el vibrato y +13 el
# barrido del ruido. Una pieza son grupos de 3 bytes: la nota (o una orden de
# 0xF2 a 0xFF) y dos bytes de argumentos.
# El canal de la RAM 0 (0xF002) suena en el C del PSG, el 1 en el B y el 2 en
# el A: `sonido_cuadro` cuenta B de 2 a 0 empezando por 0xF002, y B es el canal
# del PSG. Los efectos van en el 1 y el 2 (B y A) y pisan alli la musica.
L 0xB94C canal                     HL = el canal B (0xF002 + B x 0x20), y lo deja en su estado inicial (0xBC12)
C 0xB959 HL, el canal...
C 0xB95A ...y desde +2...
C 0xB95D ...30 bytes de 0xBC12
L 0xB969 sonido_calla              Calla el sonido: los tres canales a cero, el PSG sin ruido y los volumenes a 0
C 0xB96A sin transporte
C 0xB979 el registro 7 del PSG (RDPSG)...
C 0xB97E ...los dos bits de los puertos se quedan...
C 0xB980 ...los tonos apagados (0x38)...
C 0xB985 ...WRTPSG
C 0xB988 los tres canales, callados
L 0xB998 sonido_calla_uno          Cada canal: sin vibrato ni barrido y el volumen a 0
L 0xB9A2 canal_para                El canal deja de sonar: sin vibrato ni barrido...
L 0xB9A9 volumen                   ...y el volumen E en el registro 8 + B del PSG
L 0xB9B0 sonido_cuadro             Un cuadro del motor: los tres canales, del 2 al 0
L 0xB9B6 sonido_cuadro_uno         Un canal
L 0xB9C4 canal_cuadro              Un cuadro de un canal: el tempo, la nota, el vibrato, el barrido y la envolvente
C 0xB9C5 el canal en curso
C 0xB9C8 suena?
C 0xB9CD el tempo: cada tantos cuadros...
C 0xB9D7 ...la nota acaba?...
C 0xB9DA ...la siguiente
C 0xB9DD le queda de sonar?...
C 0xB9E0 ...si no, calla
C 0xB9E2 el vibrato
C 0xB9E9 el barrido del ruido
L 0xB9F9 canal_mudo                Ya no suena
L 0xB9FE vibrato                   El vibrato: el periodo del canal (RDPSG) mas el paso, si es de 16 o mas
C 0xBA22 WRTPSG: la parte baja...
C 0xBA2A ...y la alta
L 0xBA14 vibrato_suma              Le suma el paso (con signo)
L 0xBA20 vibrato_pon               Lo escribe
L 0xBA2E barrido                   El barrido del ruido: el registro 6 sube o baja y rebota entre 1 y 30
L 0xBA3B barrido_rebota            Rebota: el paso cambia de signo
L 0xBA45 barrido_pon               Lo escribe
L 0xBA50 envolvente                La envolvente: el paso que toca segun lo que le queda a la nota, y su volumen de la tabla del canal
C 0xBA53 acabada?
C 0xBA59 lo que le queda, por 16...
L 0xBA66 envolvente_div            La division, bit a bit
L 0xBA72 envolvente_bit            Un bit del cociente
L 0xBA7A envolvente_paso           El paso: el volumen esta en la mitad alta o baja del byte de la tabla
L 0xBA99 envolvente_volumen        El volumen del paso por el volumen del canal, entre 16
L 0xBAA3 envolvente_mult           La multiplicacion, bit a bit
L 0xBAA9 envolvente_mult_sig       El bit siguiente
L 0xBAB5 nota                      La nota siguiente de la pieza: una nota o una orden (0xF2-0xFF, tabla 0xBBF6)
C 0xBAB9 una nota?
C 0xBABC la orden: 0xFF es la 0, 0xFE la 1...
C 0xBAC2 su rutina en la tabla 0xBBF6
C 0xBAC8 al acabar, otra nota
C 0xBAD0 a la orden
L 0xBAD1 nota_pon                  Una nota: A el numero, E la duracion, D hasta la siguiente; duracion 0 es un silencio
C 0xBAE0 mas el transporte
L 0xBAE6 nota_octava               La octava: de 12 en 12
L 0xBAEF nota_periodo              El periodo de la nota (0xBC24), partido por 2 por cada octava
L 0xBAFE nota_octava_baja          Una octava mas arriba
L 0xBB05 nota_escribe              El periodo en los registros 2B y 2B+1 del PSG
L 0xBB0F nota_envolvente           Si la envolvente es de las de tabla, desde el paso 0
L 0xBB19 orden_fin                 Orden 0xFF: la pieza se acaba y el canal calla
L 0xBB21 orden_repite              Orden 0xFC: vuelve a la marca si faltan repeticiones
L 0xBB25 orden_vuelve              Orden 0xFD: vuelve a la marca
L 0xBB2B orden_salta               Orden 0xF4: salta a DE
L 0xBB31 orden_nada                Orden 0xFE: nada
L 0xBB32 orden_marca               Orden 0xFB: la marca de la repeticion y cuantas veces
L 0xBB42 orden_volumen             Orden 0xFA: el volumen del canal
L 0xBB49 envolvente_psg            La envolvente del PSG: volumen 16 y los registros 11-13
L 0xBB64 orden_envolvente          Orden 0xF9: el tipo de envolvente: del PSG o de la tabla 0xBC3C
L 0xBB7F orden_mezcla              Orden 0xF6: tono y ruido del canal en el registro 7
L 0xBB89 orden_mezcla_bit          Los bits del canal
L 0xBB8D orden_mezcla_pon          Los escribe
L 0xBBA1 orden_ruido               Orden 0xF5: el periodo del ruido y una nota de ruido
L 0xBBA7 ruido_nota                La nota de ruido: su duracion y el registro 6
L 0xBBBE pieza_lee                 Los tres bytes siguientes de la pieza: A, E, D
L 0xBBDE orden_vibrato             Orden 0xF3: el paso del vibrato y una nota
L 0xBBEA orden_barrido             Orden 0xF2: el paso del barrido y una nota de ruido
D 0xBBF6 0xBC12 ordenes  Las catorce ordenes del motor (0xFF, 0xFE... 0xF2); la 0xF8 y la 0xF7 no existen (0x0000)
F 0xBBF6 w2
D 0xBC12 0xBC24 canal_inicio  El estado inicial de un canal (desde +2): suena, la duracion, el volumen 8, la envolvente...
D 0xBC24 0xBC3C periodos  Los periodos de las doce notas de la octava mas baja (do a si)
F 0xBC24 w12
D 0xBC3C 0xBC64 envolventes  Las cinco envolventes de tabla: 16 pasos de 4 bits (8 bytes cada una)
F 0xBC3C 8
B 0xBC64 Las musicas y los efectos: cada uno pone sus piezas en sus canales. Las musicas callan antes el sonido.
L 0xBC64 musica_salida             La musica de salida de la ronda 1: tres canales (0xBD26, 0xBD63, 0xBD7F)
L 0xBC7E musica_ronda              La musica de la ronda: un canal (0xBDA4)
L 0xBC88 musica_titulo             La musica del bonus: dos canales (0xBDF8, 0xBE29)
L 0xBC9A musica_game_over          GAME OVER: tres canales (0xBE5A, 0xBE73, 0xBE8C)
L 0xBCB4 musica_choque             La caida: un canal (0xBEA5)
L 0xBCBE musica_pattern_clear      PATTERN CLEAR: tres canales (0xBEBB, 0xBEEC, 0xBF1D)
L 0xBCD6 pieza                     Pone la pieza DE en el canal B y la hace sonar
L 0xBCE0 efecto_disparo            El disparo (canal A del PSG, 0xBF33)
L 0xBCE7 efecto_enemigo            El enemigo que se acerca (canal B del PSG, 0xBF4F)
L 0xBCEE efecto_derribo            Un enemigo derribado (canal A del PSG, 0xBF77)
L 0xBCF5 efecto_aparato               El aparato que sale (canal B del PSG, 0xBF8A)
L 0xBCFC efecto_diana              Una diana o el aparato tocados (canal B del PSG, 0xBFA0)
L 0xBD03 efecto_salto              El salto (canal A del PSG, 0xBFB6)
L 0xBD0A efecto_golpe               El aparato tocado, y el esquiador del bonus en la Y 0x48 (canal A del PSG, 0xBFC3)
L 0xBD11 efecto_aparato_fuera         El aparato que se va (canal B del PSG, 0xBD62)
L 0xBD18 efecto_bandera            Una bandera (canal A del PSG, 0xBFD6)
L 0xBD1F efecto_vida               Una vida extra (canal A del PSG, 0xBFEC)
D 0xBD26 0xC000 piezas  Las piezas de las seis musicas y los diez efectos: grupos de 3 bytes (nota u orden, y sus dos argumentos)
F 0xBD26 3

# ======================================================================
# LOS DIBUJOS
# ======================================================================
# Las copias a la VRAM llevan longitudes fijas y algunas se meten en los datos
# de detras: los colores del bonus (0x9D37, 0x518 bytes) cubren tambien el
# campo y las casillas de la pista, las letras pequenas (0xB7F4, 0x180 bytes)
# acaban dentro del motor de sonido, y los nombres y dibujos de los tramos de
# nieve se pisan unos a otros. Lo que se copia de mas no se ve: cae en casillas
# que no se usan.
D 0x99C7 0x9D37 bonus_casillas  Las 110 casillas del bonus (8 bytes cada una), a partir de la 0x80
F 0x99C7 8
D 0x9D37 0x9EDF bonus_colores  Los colores de las casillas del bonus, desde la 0xB9 (la copia sigue 0x518 bytes, hasta 0xA24F)
F 0x9D37 8
D 0x9EDF 0x9FED bonus_campo  El campo del bonus en la tabla de nombres: 13 filas de 10, cinco de 25 y las tres dianas (tres filas de 5)
F 0x9EDF 10
D 0x9FED 0xA0CD pista_casillas  Las 28 casillas de la pista (0x00-0x1B): la lisa, la nieve de los bordes y las rayas; desde 0xA00D, 18 de ellas se cargan tambien de lado para el suelo (0xE0-0xF1)
F 0x9FED 8
D 0xA0CD 0xA1CD marcador_casillas  Las 32 casillas del marcador y del monte (desde la 0x80 del segundo tercio)
F 0xA0CD 8
D 0xA1CD 0xA34D sprites_esquiador  Los 12 sprites del esquiador (0x3800), que se cargan tambien de lado
F 0xA1CD 8
D 0xA34D 0xA90D sprites  Los 46 sprites de los enemigos, el aparato, lo que cae, el disparo y la explosion (desde 0x3A40)
F 0xA34D 8
D 0xA90D 0xA9CD sprites_bonus  Los seis sprites del esquiador del bonus, de cara, que se giran y se dan la vuelta para los demas dibujos
F 0xA90D 8
D 0xA9CD 0xA9ED sprite_diana  El sprite de la diana del bonus (0x3B00)
F 0xA9CD 8
D 0xA9ED 0xAA4D sprites_caida  Los tres sprites del esquiador que se cae (0x3C00)
F 0xA9ED 8
D 0xAA4D 0xAC25 nieve_casillas  Las 59 casillas de la nieve y de los objetos (desde la 0x80)
F 0xAA4D 8
D 0xAC25 0xADFD nieve_colores  Sus colores
F 0xAC25 8
D 0xADFD 0xAEDD pista_colores  Los colores de las 28 casillas de la pista; desde 0xAE1D, los del suelo
F 0xADFD 8
D 0xAEDD 0xAEF5 cifras_colores  Los colores de tres casillas del marcador
F 0xAEDD 8
D 0xAEF5 0xAF35 letras_colores  Los colores de las ocho letras grandes del marcador (0x2020)
F 0xAEF5 8
D 0xAF35 0xB02D tramo0_nombres  Las ocho filas de arriba de la pista (el monte y la nieve del fondo, 31 casillas por fila, 0xF8 bytes): el tramo 0
F 0xAF35 31
D 0xB02D 0xB06B tramo1_nombres  Lo que cambia en el tramo 1 (se copian 0xF8 bytes desde aqui)
F 0xB02D 31
D 0xB06B 0xB0C8 tramo2_nombres  Lo que cambia en el tramo 2
F 0xB06B 31
D 0xB0C8 0xB144 tramo3_nombres  Lo que cambia en el tramo 3
F 0xB0C8 31
D 0xB144 0xB774 tramo_dibujos  Los dibujos de la nieve de los cuatro tramos (60 casillas desde la 0x90, desde 0xB144, 0xB2BC, 0xB39C o 0xB424) y sus colores 0x318 bytes mas alla
F 0xB144 8
D 0xB774 0xB7F4 letras_grandes  Las letras grandes de CASIO y SKI COMMAND (16 casillas; la copia sigue 0xE0 bytes)
F 0xB774 8
D 0xB7F4 0xB94C letras  La fuente: las cifras, la (c) y las letras, desde la 0x30 (la copia lleva 0x180 bytes y acaba en 0xB974)
F 0xB7F4 8

# ----------------------------------------------------------------------
# comentarios de linea de las rutinas
# ----------------------------------------------------------------------
C 0x83AF una fila...
C 0x83B4 ...de 25 casillas 0x80
C 0x83BA la fila siguiente
C 0x83C4 desde la casilla 4...
C 0x83CA ...una fila de 25 de la misma casilla
C 0x83D1 la fila siguiente...
C 0x83D5 ...con la casilla siguiente...
C 0x83DA ...hasta la 0x0B
C 0x83E7 una fila del campo...
C 0x83EA ...de 10 casillas
C 0x83F1 la fila siguiente de la pantalla...
C 0x83F7 ...y de la tabla
C 0x8403 una fila de 25...
C 0x840A la fila siguiente...
C 0x8410 ...25 casillas mas alla en la tabla
C 0x841F una fila de 5 (una diana)
C 0x8426 la fila siguiente
C 0x842C ...5 casillas mas alla
C 0x8682 la tabla de direcciones...
C 0x8688 ...mas la direccion...
C 0x8689 ...sus bits
C 0x8757 ...y su arbol
C 0x8764 el tipo...
C 0x8765 ...del 10 al 14, otro
C 0x8771 BC = el tipo por tres
C 0x8774 su columna
C 0x8786 el tipo y el paso, del tipo
C 0x8822 la tabla de dibujos (0x8910)...
C 0x8838 en 0xE800
C 0x883B la Y...
C 0x883E ...mas la del sprite
C 0x8842 la X...
C 0x8845 ...mas la del sprite
C 0x8849 el dibujo
C 0x884C (el color se queda)
C 0x88DE uno de cada cuatro cuadros...
C 0x88E6 ...dos puntos
C 0x88EA izquierda: un punto...
C 0x88EF ...y el dibujo 3
C 0x88F5 derecha: un punto...
C 0x88F6 ...y el dibujo 6
C 0x89AF la Y del enemigo...
C 0x89B2 ...y su X
C 0x89B5 esta en marcha?
C 0x89BB la distancia en Y...
C 0x89C0 ...menos de 12?
C 0x89C4 la distancia en X...
C 0x89C9 ...menos de 13: choque
C 0x89D7 la Y y la X del esquiador...
C 0x89DA ...su casilla...
C 0x89DD ...tres filas mas abajo (los esquis)
C 0x89F5 una direccion al azar...
C 0x89F9 ...y siempre con el bit de arriba: frena
C 0x89FE 32 cuadros
C 0x8A05 una fila mas arriba
C 0x8A09 RDVRM
C 0x8A34 lo que cae...
C 0x8A37 ...y el esquiador
C 0x8A3B la distancia en X...
C 0x8A40 ...menos de 8?
C 0x8A43 la distancia en Y (8 mas abajo)...
C 0x8A4A ...menos de 8: choque
C 0x8B20 al azar...
C 0x8B23 ...de 1 a 3...
C 0x8B28 ...en la tabla de tipos
C 0x8B30 su color
C 0x8B37 Y, X, paso y tipo
C 0x8B3A el color, a A'
C 0x8B42 el tipo, por dos, en la tabla
C 0x8B59 la Y y la X, mas el desplazamiento
C 0x8B66 la Y
C 0x8B68 la X
C 0x8B6A el dibujo...
C 0x8B72 ...y el color
C 0x8C85 la Y, cuatro puntos menos
C 0x8C91 RDVRM de la casilla de delante
C 0x8C99 el resultado a A'
C 0x8CA0 y la de la derecha
C 0x8CAA en la parte de abajo...
C 0x8CB1 ...la distancia en X...
C 0x8CBA ...a que lado
C 0x8CC2 al azar, un lado
C 0x8CD1 la casilla de alli
C 0x8CD6 libre?
C 0x8CDD paso de lado -2
C 0x8CE2 cuatro puntos a la izquierda...
C 0x8CE7 ...la casilla de alli
C 0x8CEC libre?
C 0x8CF7 cuatro a la derecha...
C 0x8CFD ...la casilla de alli
C 0x8D0A sin paso de lado
C 0x8D0D lo que sube la pista...
C 0x8D11 ...a la contra
C 0x8D17 sube con la pista...
C 0x8D1C el tamano 0
C 0x8D1E el enemigo en curso
C 0x8D25 tamano 1...
C 0x8D26 ...y un punto mas
C 0x8D2B tamano 2...
C 0x8D2C ...y dos mas
C 0x8D32 tamano 3...
C 0x8D33 ...y tres mas
C 0x8D3A el canal 2 suena?...
C 0x8D3E ...si no, el sonido del enemigo
C 0x8D54 guarda Y, X, paso y tipo
C 0x8D88 al azar...
C 0x8D8B ...de 1...
C 0x8D8F ...a 7
C 0x8D93 el tipo
C 0x8DA8 el tipo, a A'
C 0x8DAB la tabla del tamano...
C 0x8DAF ...su puntero
C 0x8DB8 la Y...
C 0x8DB9 ...mas la del sprite
C 0x8DBB a la tabla
C 0x8DBE la X...
C 0x8DBF ...mas la del sprite
C 0x8DC4 el segundo sprite (las piernas)...
C 0x8DC9 ...con el paso de lado
C 0x8DCF la X a la tabla
C 0x8DD2 el dibujo
C 0x8DDB los colores del tipo...
C 0x8DE6 ...mas el del sprite
C 0x8DED el color
C 0x8DF7 el sprite siguiente
C 0x8EF6 el dibujo del disparo lejano
C 0x902E la columna en la tabla de nombres
C 0x9036 los que sobran del principio...
C 0x903D ...se saltan
C 0x9046 la fila siguiente de la tabla
C 0x904B se sale de la tabla?...
C 0x9054 ...vuelve a su principio
C 0x9059 la fila siguiente, 32 mas
C 0x905F una casilla menos
C 0x9070 la tabla de la derecha
C 0x9074 fila 9, columna 15
C 0x907D cinco casillas...
